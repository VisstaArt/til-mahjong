          { "tr": "Tamam. Vapurunuz saat kaçta?", "ru": "Хорошо. Во сколько ваш пароход?" }
        ]},
        { "speaker": "a", "tr": "Harika! Kaç lira?", "ru": "Отлично! Сколько с меня?", "distractors": [
          { "tr": "Günaydın! İskeleye, lütfen. Acelem var.", "ru": "Доброе утро! На пристань, пожалуйста. Я спешу." },
