        { "speaker": "a", "tr": "Çok teşekkürler! İyi günler!", "ru": "Большое спасибо! Хорошего дня!", "distractors": [
          { "tr": "Affedersiniz, saat kaç?", "ru": "Извините, который час?" },
          { "tr": "Saat beş.", "ru": "Пять часов." }
        ]},
        { "speaker": "b", "tr": "İyi günler!", "ru": "Хорошего дня!", "distractors": [
          { "tr": "Affedersiniz, saat kaç?", "ru": "Извините, который час?" },
          { "tr": "Saat beş.", "ru": "Пять часов." }
