{"id": "ustoychivye-vyrazheniya-so-slovom-allah", "title": "Устойчивые выражения со словом «Allah»", "source": "allah", "phrases": [{"ru": "Видит Бог! Аллах свидетель!", "tr": "Alimallah", "tl": null, "sub": "A"}, {"ru": "Аллах сказал: «Иди, раб мой!» (о человеке, которому очень везёт)", "tr": "Allah \"Yürü ya kulum\" demiş", "tl": null, "sub": "A"}, {"ru": "Спасибо. Пусть Аллах будет тобой доволен.", "tr": "Allah (senden) razı olsun", "tl": null, "sub": "A"}, {"ru": "Кричать «Аллах-Аллах!», сильно возмущаться", "tr": "Allah Allah bağırmak", "tl": null, "sub": "A"}, {"ru": "О, Господи! / Вот это да! (удивление, раздражение)", "tr": "Allah Allah!", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах смилуется!", "tr": "Allah acısın!", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не даст забыть эту боль (говорят при соболезновании)", "tr": "Allah acısını unutturmasın", "tl": null, "sub": "A"}, {"ru": "Да наградит Аллах умом!", "tr": "Allah akıl fikir versin", "tl": null, "sub": "A"}, {"ru": "Да вразумит их Аллах!", "tr": "Allah akıllar versin", "tl": null, "sub": "A"}, {"ru": "Пусть хуже не будет!", "tr": "Allah aratmasın!", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не делает тебя (или кого-то) инвалидом", "tr": "Allah azadan noksanlık vermesin", "tl": null, "sub": "A"}, {"ru": "Ради Аллаха! Во имя Аллаха!", "tr": "Allah aşkın(ız)a!", "tl": null, "sub": "A"}, {"ru": "Аллах мне — я тебе (ирония)", "tr": "Allah bana, ben de sana", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах хранит! Пусть будет здоров (о детях)", "tr": "Allah bağışlasın!", "tl": null, "sub": "A"}, {"ru": "Упаси Аллах от худшего!", "tr": "Allah beterinden saklasın", "tl": null, "sub": "A"}, {"ru": "Аллах знает! / Бог его знает!", "tr": "Allah bilir", "tl": null, "sub": "A"}, {"ru": "Аллах знает, а человек догадывается", "tr": "Allah bilir ama kul da sezer", "tl": null, "sub": "A"}, {"ru": "Лгун: кроме слов «Аллах един», ему нельзя верить", "tr": "Allah bir dediğinden gayri sözüne inanılmaz", "tl": null, "sub": "A"}, {"ru": "Аллах одну дверь закрывает — другую открывает", "tr": "Allah bir kapıyı kapatır, öbür kapıyı açar", "tl": null, "sub": "A"}, {"ru": "Клянусь, Аллах един! (клятва)", "tr": "Allah bir!", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах приумножит твоё в тысячу раз", "tr": "Allah birini bin etsin", "tl": null, "sub": "A"}, {"ru": "Аллах дал рост, а остального не дал (о высоких, но пустоватых людях)", "tr": "Allah boy vermiş gerisini koy vermiş", "tl": null, "sub": "A"}, {"ru": "Да убережет нас Аллах от худшего", "tr": "Allah bundan geri koymasın", "tl": null, "sub": "A"}, {"ru": "Аллах велик!", "tr": "Allah büyüktür!", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не поставит невежду над людьми", "tr": "Allah cahili, amir yapmasın", "tl": null, "sub": "A"}, {"ru": "Аллах даёт каждому по просьбе (букв. стекло — просящему стекло, свечу — просящему свечу)", "tr": "Allah cam isteyene cam, mum isteyene mum verir", "tl": null, "sub": "A"}, {"ru": "Лучше бы мне умереть!", "tr": "Allah canımı alaydı", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах заберёт мою жизнь! (клятва)", "tr": "Allah canımı alsın!", "tl": null, "sub": "A"}, {"ru": "Пусть накажет его Аллах!", "tr": "Allah cezasını versin", "tl": null, "sub": "A"}, {"ru": "Аллах каждому воздает по заслугам", "tr": "Allah dağına göre kar verir", "tl": null, "sub": "A"}, {"ru": "Не знать, что сказать", "tr": "Allah demek", "tl": null, "sub": "A"}, {"ru": "Не знаю, что и сказать…", "tr": "Allah derim", "tl": null, "sub": "A"}, {"ru": "Аллах даёт беду и исцеление", "tr": "Allah dert verir, derman da verir", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах дарует мир и порядок в жизни!", "tr": "Allah dirlik düzenlik versin!", "tl": null, "sub": "A"}, {"ru": "Чему быть — того не миновать", "tr": "Allah dokuzda verdiğini sekizde almaz", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не разлучит (часто о родителях и ребёнке)", "tr": "Allah dört gözden ayırmasın", "tl": null, "sub": "A"}, {"ru": "Не приведи Аллах моему врагу!", "tr": "Allah düşmanıma vermesin", "tl": null, "sub": "A"}, {"ru": "Да поможет тебе Аллах быть терпеливым и стойким!", "tr": "Allah ecir sabır versin", "tl": null, "sub": "A"}, {"ru": "Аллах велик!", "tr": "Allah(u) ekber!", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не лишит (этого блага)", "tr": "Allah eksik etmesin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не покажет отсутствие этого (не дай Бог лишиться)", "tr": "Allah eksikliğini göstermesin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не оставит твой труд напрасным (букв. «не отдаст тебе твои труды в руки впустую»)", "tr": "Allah emeklerini eline vermesin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах дарует благополучный конец (жизни/делу)", "tr": "Allah encamını hayır eyleye", "tl": null, "sub": "A"}, {"ru": "Аллах дал сливу — тому, у кого нет зубов", "tr": "Allah erik vermiş, dişi olmayan ağıza", "tl": null, "sub": "A"}, {"ru": "Аллах даёт мясо — беззубым (о тех, кому достаётся то, чем не могут воспользоваться)", "tr": "Allah eti dişsizlere verir", "tl": null, "sub": "A"}, {"ru": "Не дай Бог! Не допусти этого, Аллах!", "tr": "Allah etmesin!", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах приумножит твою благодать/успехи (часто об учёбе)", "tr": "Allah feyzini artırsın", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах обильно дарует милость покойному (Царствие ему Небесное)", "tr": "Allah gani gani rahmet eyleye (etsin)", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не даст умереть молодым и не даст страдать в старости", "tr": "Allah gençlikte ölüm, kocalıkta zulüm vermesin", "tl": null, "sub": "A"}, {"ru": "Боготворить", "tr": "Allah gibi saymak", "tl": null, "sub": "A"}, {"ru": "Пусть исполнит твои желания", "tr": "Allah gönlüne göre versin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не допустит этого/пусть Аллах простит все грехи", "tr": "Allah göstermesin/etmesin/günahları affetsin", "tl": null, "sub": "A"}, {"ru": "Да ослепит меня Аллах, если… (клятва)", "tr": "Allah gözümü kör etsin ki", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не погасит твою улыбку", "tr": "Allah güler yüzünü soldurmasın", "tl": null, "sub": "A"}, {"ru": "Клянусь Аллахом! Во имя Аллаха!", "tr": "Allah hakkı için", "tl": null, "sub": "A"}, {"ru": "Хорошей торговли! Пусть Аллах даст удачу в торговле", "tr": "Allah hayırlı pazar versin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах будет доволен тобой!", "tr": "Allah hoşnut olsun!", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах исцелит, исправит (человека)", "tr": "Allah iflah etsin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах даст вам состариться на одной подушке (пожелание молодожёнам)", "tr": "Allah ikinizi bir yastıkta kocatsın", "tl": null, "sub": "A"}, {"ru": "Да поможет Аллах", "tr": "Allah imdat eylesin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не собьёт человека с пути", "tr": "Allah insanı şaşırtmasın", "tl": null, "sub": "A"}, {"ru": "Да даст Аллах всего хорошего", "tr": "Allah iyilik versin", "tl": null, "sub": "A"}, {"ru": "Ради Аллаха / Ради Бога / Во имя Бога!", "tr": "Allah için", "tl": null, "sub": "A"}, {"ru": "Говорить честно; говорить ради истины", "tr": "Allah için söylemek", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах поможет в деле", "tr": "Allah işini rast getirsin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах примет (молитву)", "tr": "Allah kabul etsin", "tl": null, "sub": "A"}, {"ru": "Проклятая жизнь! (букв. жизнь, которую бы Аллах проклял)", "tr": "Allah kahredesi hayat!", "tl": null, "sub": "A"}, {"ru": "Пусть его покарает Аллах!", "tr": "Allah kahretsin!", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах повесит тебе на двери черные замки (пожелание неудачи в семье, проклятие)", "tr": "Allah kapına kara kilitler asılsın", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах даст чернобрового, черноглазого суженого(ую)", "tr": "Allah kara kaşlı kara gözlü nişanlı versin", "tl": null, "sub": "A"}, {"ru": "Дружба дружбой, а деньги врозь", "tr": "Allah kardeşi kardeş yaratmış, kesesini ayrı yaratmış", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах сведёт / даст встретиться", "tr": "Allah kavuştursun", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах убережёт от бед", "tr": "Allah kazadan belâdan saklasın", "tl": null, "sub": "A"}, {"ru": "Слово Аллаха, откровение (Коран)", "tr": "Allah kelâmı", "tl": null, "sub": "A"}, {"ru": "Аллах милостив / Аллах щедр", "tr": "Allah kerim", "tl": null, "sub": "A"}, {"ru": "Не дай Аллах никому такого испытания", "tr": "Allah kimsenin başına getirmesin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах не даст никому испытать смерть ребёнка", "tr": "Allah kimseye evlat acısı tattırmasın", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах облегчит (работу/путь); Бог в помощь!", "tr": "Allah kolaylık versin", "tl": null, "sub": "A"}, {"ru": "Сохрани Аллах!", "tr": "Allah korusun", "tl": null, "sub": "A"}, {"ru": "Да спасёт Аллах!", "tr": "Allah kurtarsın", "tl": null, "sub": "A"}, {"ru": "Да воздаст ему Аллах по заслугам!", "tr": "Allah lâyığını versin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах будет помощником", "tr": "Allah muinin olsun", "tl": null, "sub": "A"}, {"ru": "Да благословит Аллах", "tr": "Allah mübarek etsin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах даст ему по заслугам (часто — наказание)", "tr": "Allah müstahakını versin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах исполнит, что пожелаешь", "tr": "Allah ne muradın varsa versin", "tl": null, "sub": "A"}, {"ru": "Что Бог дал — тем и довольны", "tr": "Allah ne verdiyse", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах дарует долгие годы жизни", "tr": "Allah nice yıllara yetiştirsin", "tl": null, "sub": "A"}, {"ru": "Спокойной ночи (букв. пусть Аллах даст покой)", "tr": "Allah rahatlık versin", "tl": null, "sub": "A"}, {"ru": "Нет добра в том, что делается без согласия Аллаха", "tr": "Allah rızası gösterilmeyen hiçbir şeyde hayır yoktur", "tl": null, "sub": "A"}, {"ru": "Ради Аллаха, умоляю!", "tr": "Allah rızası için", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах отвратит тебя от этого табака", "tr": "Allah sana bu tütünden ikrahlık versin", "tl": null, "sub": "A"}, {"ru": "Пусть самые любимые тобой (твои дети) причинят тебе страдания (очень сильное проклятие)", "tr": "Allah sende oğlundan kızından bul", "tl": null, "sub": "A"}, {"ru": "Клянусь Аллахом, это правда (букв. пусть Аллах заставит тебя поверить)", "tr": "Allah seni inandırsın", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах дарует вам счастье в обоих мирах (в этом и в вечном)", "tr": "Allah size her iki cihanda da saadet versin", "tl": null, "sub": "A"}, {"ru": "Несправедливый/неравный удел (букв. «делёж от Аллаха»)", "tr": "Allah taksimi", "tl": null, "sub": "A"}, {"ru": "Да простит нам Аллах наши прегрешения", "tr": "Allah taksiratımızı affetsin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах поможет (закончить что-либо)", "tr": "Allah tamamına yetiştirsin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах даст долгую жизнь (столько, сколько земли)", "tr": "Allah toprağı kadar ömür versin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах превратит всё, к чему ты прикоснёшься, в золото (пожелание удачи)", "tr": "Allah tuttuğunu altın etsin", "tl": null, "sub": "A"}, {"ru": "Дай Аллах!", "tr": "Allah vere!", "tl": null, "sub": "A"}, {"ru": "Данное от рождения; дар от Бога", "tr": "Allah vergisi", "tl": null, "sub": "A"}, {"ru": "Не щадить, не жалеть (букв. не помнить, что Аллах создал)", "tr": "Allah yarattı dememek", "tl": null, "sub": "A"}, {"ru": "Если Аллах помогает рабу, всё пойдёт как надо", "tr": "Allah yardım ederse kuluna, her iş girer yoluna", "tl": null, "sub": "A"}, {"ru": "Да поможет тебе Аллах!", "tr": "Allah yardımcın olsun", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах отменит дурное предопределение", "tr": "Allah yazdıysa bozsun", "tl": null, "sub": "A"}, {"ru": "Нет того, кому поклоняются, кроме Аллаха; Он — Чалап", "tr": "Allah'tan yoktur tapacak, Çalaptır ancak", "tl": null, "sub": "A"}, {"ru": "Счастливого пути! Пусть путь будет открыт Аллахом", "tr": "Allah yolunu açık etsin", "tl": null, "sub": "A"}, {"ru": "Да продлит твою жизнь Аллах", "tr": "Allah ömrünü uzun etsin", "tl": null, "sub": "A"}, {"ru": "Да поможет ему Аллах исправиться", "tr": "Allah ıslah etsin", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах даст исцеление; дай Бог здоровья", "tr": "Allah şifasını versin", "tl": null, "sub": "A"}, {"ru": "Клясться именем Аллаха", "tr": "Allah adına ant içmek/vermek/etmek", "tl": null, "sub": "A"}, {"ru": "Тысяча благодарностей Аллаху! / Слава Богу!", "tr": "Allah'a bin şükür", "tl": null, "sub": "A"}, {"ru": "Быть должным душу только Аллаху", "tr": "Allah'a bir can borcu olmak", "tl": null, "sub": "A"}, {"ru": "На Бога надейся, а сам не плошай (а сам греби к берегу)", "tr": "Allah'a dua et ama, kıyıya doğru kürek çekmeyi de ihmal etme", "tl": null, "sub": "A"}, {"ru": "Молиться Аллаху", "tr": "Allah'a dua etmek", "tl": null, "sub": "A"}, {"ru": "До свидания; да хранит вас Аллах", "tr": "Allah'a emanet olun!", "tl": null, "sub": "A"}, {"ru": "Пусть хранит Аллах!", "tr": "Allah'a emanet!", "tl": null, "sub": "A"}, {"ru": "Положиться на Аллаха; поручить Аллаху исход дела", "tr": "Allah'a havale etmek", "tl": null, "sub": "A"}, {"ru": "Зависит от Аллаха; повисло в неопределённости", "tr": "Allah'a kaldı", "tl": null, "sub": "A"}, {"ru": "Отдай разбитое сердце Аллаху — Он исцелит его; отдай целое женщине — она разобьёт (ирония)", "tr": "Allah'a kırık kalbini ver ki onu tamamlasın; kadına tamam kalbini ver ki onu parçalasın", "tl": null, "sub": "A"}, {"ru": "Доверяться Аллаху, уповать только на Бога", "tr": "Allah'a sığınmak", "tl": null, "sub": "A"}, {"ru": "До свидания (дословно: «оставили на Аллаха»)", "tr": "Allah'a ısmarladık", "tl": null, "sub": "A"}, {"ru": "Слава Богу! Слава Аллаху!", "tr": "Allah'a şükür", "tl": null, "sub": "A"}, {"ru": "От Аллаха; врождённый, данный Богом", "tr": "Allah'tan", "tl": null, "sub": "A"}, {"ru": "Да накажет его Аллах!", "tr": "Allah'tan bulsun!/Allah'ından bulsun", "tl": null, "sub": "A"}, {"ru": "Просить что-то у Аллаха", "tr": "Allah'tan dilekte bulunmak", "tl": null, "sub": "A"}, {"ru": "Побойся Бога!", "tr": "Allah'tan kork", "tl": null, "sub": "A"}, {"ru": "Надо бояться того, кто не боится Аллаха", "tr": "Allah'tan korkmayandan korkmalı", "tl": null, "sub": "A"}, {"ru": "Несправедливый, жестокий человек (кто не боится Бога)", "tr": "Allah'tan korkmaz", "tl": null, "sub": "A"}, {"ru": "Дай Бог!", "tr": "Allah'tan olacak", "tl": null, "sub": "A"}, {"ru": "Хорошо, что…", "tr": "Allah'tan(ki)!", "tl": null, "sub": "A"}, {"ru": "Аллаху это известно лучше вас", "tr": "Allahu a'lem", "tl": null, "sub": "A"}, {"ru": "Аллах велик! / Бог велик!", "tr": "Allahu ekber!", "tl": null, "sub": "A"}, {"ru": "Ради Аллаха", "tr": "Allah'ı seversen", "tl": null, "sub": "A"}, {"ru": "Укромное, уединенное местечко", "tr": "Allah'ı çok, insanı az bir yer", "tl": null, "sub": "A"}, {"ru": "Боже мой! О, мой Аллах!", "tr": "Allah'ım!", "tl": null, "sub": "A"}, {"ru": "В лютый мороз", "tr": "Allah'ın ayazında", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах накажет тебя!", "tr": "Allah'ın belânı versin!", "tl": null, "sub": "A"}, {"ru": "Наказание Аллаха; наказание свыше (иногда — о ребёнке «бедовый»)", "tr": "Allah'ın belâsı", "tl": null, "sub": "A"}, {"ru": "Проклятое место", "tr": "Allah'ın belâsı yer", "tl": null, "sub": "A"}, {"ru": "Разрушить себя или другого (букв. разрушить творение Аллаха)", "tr": "Allah'ın binasını yıkmak", "tl": null, "sub": "A"}, {"ru": "Наказание Аллаха; наказание божье (о ребенке)", "tr": "Allah'ın cezası", "tl": null, "sub": "A"}, {"ru": "Воля Аллаха", "tr": "Allah'ın emri", "tl": null, "sub": "A"}, {"ru": "По воле Аллаха и слову пророка (формула при сватовстве)", "tr": "Allah'ın emriyle peygamberin kavliyle", "tl": null, "sub": "A"}, {"ru": "Дом Аллаха; мечеть (также: человеческая душа)", "tr": "Allah'ın evi", "tl": null, "sub": "A"}, {"ru": "Обидеть резкими словами", "tr": "Allah'ın evini yıkmak", "tl": null, "sub": "A"}, {"ru": "Божий гнев", "tr": "Allah'ın gazabı", "tl": null, "sub": "A"}, {"ru": "Пусть Аллах покарает меня, если я… (клятва)", "tr": "Allah'ın gazabına geleyim ki", "tl": null, "sub": "A"}, {"ru": "Чтоб Аллах тебя наказал", "tr": "Allah'ın gazabına uğra", "tl": null, "sub": "A"}, {"ru": "Пути Господни неисповедимы", "tr": "Allah'ın hikmeti", "tl": null, "sub": "A"}, {"ru": "Милостью Аллаха", "tr": "Allah'ın inayetiyle", "tl": null, "sub": "A"}, {"ru": "С позволения Аллаха", "tr": "Allah'ın izniyle", "tl": null, "sub": "A"}, {"ru": "Посмотри, что из этого получилось!", "tr": "Allah'ın işine bak", "tl": null, "sub": "A"}, {"ru": "Раб Божий", "tr": "Allah'ın kulu", "tl": null, "sub": "A"}, {"ru": "Бескрайняя степь", "tr": "Allah'ın kırı", "tl": null, "sub": "A"}, {"ru": "Милость Аллаха", "tr": "Allah'ın lütfu", "tl": null, "sub": "A"}, {"ru": "Ленивый человек; лодырь", "tr": "Allah'ın tembeli", "tl": null, "sub": "A"}, {"ru": "Пусть любящий Аллаха не удерживает меня! (дайте пройти / не держите!)", "tr": "Allah'ını seven tutmasın", "tl": null, "sub": "A"}, {"ru": "Если бы Аллах дал верблюду крылья, он бы разрушил крыши (если дать силу невежде — будет беда)", "tr": "Allah, deveye kanat verseydi damı taşı dağıtırdı", "tl": null, "sub": "A"}, {"ru": "Находиться на чужбине", "tr": "Allah'tan uzun yerde bulunmak", "tl": null, "sub": "A"}, {"ru": "Взывать к помощи Аллаха!", "tr": "Aman Allah çağırmak", "tl": null, "sub": "A"}, {"ru": "Помилуй, Боже!", "tr": "Aman Allah!", "tl": null, "sub": "A"}, {"ru": "Повинную голову меч не сечет", "tr": "Aman diyene kılıç kalkmaz", "tl": null, "sub": "A"}, {"ru": "Беспощадно, неумолимо", "tr": "Aman vermeden", "tl": null, "sub": "A"}, {"ru": "Беспощадный, жестокий", "tr": "Aman vermez", "tl": null, "sub": "A"}, {"ru": "Помилуй, Господи!", "tr": "Aman ya Rabbi!", "tl": null, "sub": "A"}, {"ru": "Ох, Боже! Ради Бога!", "tr": "Aman!", "tl": null, "sub": "A"}, {"ru": "Боже, какая красота!", "tr": "Aman, ne güzel!", "tl": null, "sub": "A"}, {"ru": "Умолять о пощаде", "tr": "Amana binmek", "tl": null, "sub": "A"}, {"ru": "Спастись, освободиться", "tr": "Amana bulmak", "tl": null, "sub": "A"}, {"ru": "Заставить просить пощады", "tr": "Amana dedirmek", "tl": null, "sub": "A"}, {"ru": "Потерять всякую надежду", "tr": "Amana gelmek", "tl": null, "sub": "A"}, {"ru": "Да благословит Аллах! Да осчастливит Аллах!", "tr": "Berekallah(u)!", "tl": null, "sub": "B"}, {"ru": "Это знаю только я и Аллах", "tr": "Bir ben bir de Allah bilir", "tl": null, "sub": "B"}, {"ru": "Пусть Аллах воздаст сторицей (в тысячу раз)", "tr": "Bir yerine bin versin Allah", "tl": null, "sub": "B"}, {"ru": "Во имя Аллаха", "tr": "Bismillah", "tl": null, "sub": "B"}, {"ru": "Господи, что это ещё такое?", "tr": "Bismillah bu da nesi!", "tl": null, "sub": "B"}, {"ru": "Произносить «во имя Аллаха» (перед началом какого-либо дела)", "tr": "Bismillah ile başlamak", "tl": null, "sub": "B"}, {"ru": "Поручить свою душу Аллаху (готовиться к смерти/опасности)", "tr": "Canını Allah'a ısmarlamak", "tl": null, "sub": "C"}, {"ru": "Лик Аллаха, видение Лика Аллаха (блаженное лицезрение)", "tr": "Cemalullah", "tl": null, "sub": "C"}, {"ru": "Великий Аллах", "tr": "Cenâb-ı Allah", "tl": null, "sub": "C"}, {"ru": "Некрасивость — от Аллаха, а что мешает умыться? (ирония: недостатки нельзя оправдывать судьбой)", "tr": "Çirkinliğin Allah'tan, yüz yıkamaman neden?", "tl": null, "sub": "Ç"}, {"ru": "Если твой судья — кадий, пусть Аллах поможет тебе (против сильного не поспоришь)", "tr": "Davacın kadı ise yardımcın Allah olsun", "tl": null, "sub": "D"}, {"ru": "Сначала привяжи верблюда, потом доверяй Аллаху (на Бога надейся, но сам не плошай)", "tr": "Deveyi sağlam bağla sonra Allah'a emanet et", "tl": null, "sub": "D"}, {"ru": "Только Аллах не падает (не ошибается) — человек может ошибиться", "tr": "Düşmez kalkmaz bir Allah", "tl": null, "sub": "D"}, {"ru": "Хвала Аллаху", "tr": "Elhamdülillah", "tl": null, "sub": "E"}, {"ru": "Прежде всего — на Аллаха!", "tr": "Evvel Allah!", "tl": null, "sub": "E"}, {"ru": "Сперва привяжи верблюда — потом поручай его Аллаху (пословица)", "tr": "Evvel deveni bağla sonra Allah'a ısmarla", "tl": null, "sub": "E"}, {"ru": "Спасибо / ладно / с Богом / хорошо", "tr": "Eyvallah", "tl": null, "sub": "E"}, {"ru": "Соглашаться, не возражать", "tr": "Eyvallah demek", "tl": null, "sub": "E"}, {"ru": "Уступать / поддакивать / проявлять смирение", "tr": "Eyvallah etmek", "tl": null, "sub": "E"}, {"ru": "Не уважать; быть несговорчивым, не подчиняться", "tr": "Eyvallahı olmamak", "tl": null, "sub": "E"}, {"ru": "Ух! Ой! (удивление / недоумение / досада)", "tr": "Fesüphanallah", "tl": null, "sub": "F"}, {"ru": "Во имя Аллаха; даром, безвозмездно", "tr": "Fisebilillah", "tl": null, "sub": "F"}, {"ru": "Гнездо одинокой птицы строит Аллах (Аллах помогает беззащитным)", "tr": "Garip kuşun yuvasını Allah yapar", "tl": null, "sub": "G"}, {"ru": "Кто видел — пусть скажет ради Аллаха (просьба подтвердить правду)", "tr": "Gören Allah için söylesin", "tl": null, "sub": "G"}, {"ru": "Да сохранит вас Аллах!", "tr": "Hafazanallah", "tl": null, "sub": "H"}, {"ru": "Пусть накажет Аллах!", "tr": "Hakkından Allah gelsin", "tl": null, "sub": "H"}, {"ru": "Ради Аллаха!", "tr": "Hasbetenlillah", "tl": null, "sub": "H"}, {"ru": "Все от Бога (Всё, что ни делается, — к лучшему)", "tr": "Her şey Allah'tan", "tl": null, "sub": "H"}, {"ru": "До скончания века; до бесконечности; не сглазить бы; браво!", "tr": "İlâ meşallah", "tl": null, "sub": "İ"}, {"ru": "Дела — хоть куда! (слава Аллаху)", "tr": "İlâ meşallah işimiz yolunda", "tl": null, "sub": "İ"}, {"ru": "Первую жену даёт Аллах, вторую — люди, третью — шайтан (ирон. поговорка)", "tr": "İlk karını sana Allah, ikinci karını insanlar, üçüncüsünü ise şeytan gönderir", "tl": null, "sub": "İ"}, {"ru": "Дай Бог!", "tr": "İnşallah!", "tl": null, "sub": "İ"}, {"ru": "Последняя надежда на Аллаха", "tr": "İşi Allah'a kaldı", "tl": null, "sub": "İ"}, {"ru": "Слепой просил один глаз — Аллах дал два (Аллах даёт больше, чем просят)", "tr": "Körün istediği bir göz, Allah verdi iki göz", "tl": null, "sub": "K"}, {"ru": "Происходит не так, как хочет человек, а так, как решит Аллах", "tr": "Kulun dediği olmaz, Allah'ın dediği olur", "tl": null, "sub": "K"}, {"ru": "Ради Аллаха", "tr": "Lillah", "tl": null, "sub": "L"}, {"ru": "Вот это да! (выражает восторг, удивление); Не сглазить бы! (отговорка от сглаза при восхищении кем-то, в частности детьми); рады вас видеть; Молодцы! Тьфу-тьфу чтоб не сглазить!", "tr": "Maşallah", "tl": null, "sub": "M"}, {"ru": "Добро пожаловать!", "tr": "Maşallah hoş geldiniz", "tl": null, "sub": "M"}, {"ru": "Браво! Молодец! Хорош собой", "tr": "Maşallahı var", "tl": null, "sub": "M"}, {"ru": "Сохрани Аллах", "tr": "Maazallah", "tl": null, "sub": "M"}, {"ru": "От Аллаха; благодаря Аллаху", "tr": "Mintarafillah", "tl": null, "sub": "M"}, {"ru": "Да упасёт нас Аллах; прибегаем к защите Аллаха", "tr": "Nâuzübillah", "tl": null, "sub": "N"}, {"ru": "Это известно одному Аллаху", "tr": "Orasını Allah bilir", "tl": null, "sub": "O"}, {"ru": "Смерть — веление Аллаха", "tr": "Ölüm Allah'ın emri", "tl": null, "sub": "Ö"}, {"ru": "Смерть неизбежна — но это я всё равно сделаю! (решимость)", "tr": "Ölüm Allah'ın emri, bu işi yapacağım!", "tl": null, "sub": "Ö"}, {"ru": "С тебя — почин, от Аллаха — благоденствие (я надеюсь, ты принесешь мне удачу); обращение к покупателю, в торговле", "tr": "Siftah senden bereketi Allah'tan", "tl": null, "sub": "S"}, {"ru": "Пусть Аллах приведет к благополучному концу", "tr": "Sonunu Allah hayır eyliye", "tl": null, "sub": "S"}, {"ru": "Клянусь Аллахом (не нарушу слова)", "tr": "Söz, Allah bir!", "tl": null, "sub": "S"}, {"ru": "Ей Богу! В самом деле!", "tr": "Tallahi", "tl": null, "sub": "T"}, {"ru": "Ей Богу! Правда!", "tr": "Vallah! / Vallahi!", "tl": null, "sub": "V"}, {"ru": "Ей Богу!", "tr": "Vallah billah! / Vallahi billahi!", "tl": null, "sub": "V"}, {"ru": "Эй! Иди! Марш! Уходи!", "tr": "Yallah", "tl": null, "sub": "Y"}, {"ru": "Марш на улицу!", "tr": "Yallah sokağa!", "tl": null, "sub": "Y"}]}