{
  "id": "znakomstvo",
  "title": "Знакомство",
  "source": "razgovornik",
  "phrases": [
    {
      "ru": "Будет вечеринка.",
      "tr": "Bir parti var.",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Ты придешь?",
      "tr": "Sen de geliyor musun?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Хочешь поужинать вместе с нами …?",
      "tr": "… bizimle akşam yemeği yemek ister misin?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Может зайдешь чего-нибудь выпить сегодня вечером?",
      "tr": "Bu akşam bir içki içmeye gelebilir misin?",
      "tl": "Бу акшам бир ички ичмейе гэлебилир мисин?",
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Можно пригласить тебя на обед?",
      "tr": "Seni öğle yemeğine davet edebilir miyim?",
      "tl": "Сэни ёйле йемейинэ давэт эдэбилир мийим?",
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Спасибо большое. Очень любезно с твоей стороны",
      "tr": "Çok naziksin",
      "tl": "Чок назиксин",
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Здорово.",
      "tr": "Harika.",
      "tl": "Харика.",
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Я с удовольствием приду",
      "tr": "Büyük bir zevkle gelirim",
      "tl": "Бюйюк бир зэвкле гэлирим",
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "К сожалению, мне надо идти",
      "tr": "Ne yazık ki şimdi ayrılmak zorundayım",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Приходи к нам в следующий раз",
      "tr": "Gelecek sefere seni bize bekliyoruz",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Могу я пойти с вами?",
      "tr": "Size katılabilir miyim?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Почему бы тебе не пойти с нами?",
      "tr": "Bize katılsana?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Ты кого-то ждешь?",
      "tr": "Birisini mi bekliyorsun?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Не возражаешь, если я присяду рядом?",
      "tr": "Buraya oturmam seni rahatsız eder mi?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Могу я заказать тебе чего-нибудь выпить?",
      "tr": "Sana bir içki ısmarlayabilir miyim?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Почему ты смеешься?",
      "tr": "Ne/neden gülüyorsun?",
      "tl": "Нэ/нэдэн гюлюйорсун?",
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "У тебя есть планы на вечер?",
      "tr": "Bu akşam bir şey yapıyor musun?",
      "tl": "Бу акшам бир шэй япыйор мусун?",
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Хочешь, сходим куда-нибудь вместе?",
      "tr": "Bu akşam benimle çıkmak ister misin?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Ты сегодня вечером свободен/ свободна?",
      "tr": "Bu akşam boş musun?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Пойдем потанцуем сегодня вечером?",
      "tr": "Bu akşam benimle dansa gitmek ister misin?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Я знаю хорошую дискотеку",
      "tr": "İyi bir diskotek biliyorum",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Может, сходим в кино?",
      "tr": "Sinemaya gidelim mi?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Хочешь, покатаемся на машине?",
      "tr": "Arabayla gezmek ister misin?",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "С удовольствием.",
      "tr": "Çok iyi olur.",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Спасибо",
      "tr": "Teşekkür ederim",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Спасибо, но я занят/занята",
