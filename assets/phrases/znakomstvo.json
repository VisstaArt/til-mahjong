      "level": "A1"
    },
    {
      "ru": "Я из Москвы.",
      "tr": "Moskovalıyım.",
      "tl": "Москвалыйым.",
      "sub": "Откуда ты",
      "level": "A1"
    },
    {
      "ru": "Вы из Стамбула?",
