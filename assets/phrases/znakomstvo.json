      "tl": "Лютфэн яваш конушун.",
      "sub": "Язык",
      "level": "A1"
    },
    {
      "ru": "Добро пожаловать!",
      "tr": "Hoş geldiniz!",
      "tl": "Хош гэлдиниз!",
      "sub": "Рад знакомству",
      "level": "A1"
    },
    {
      "ru": "Спасибо! (ответ на «Добро пожаловать»)",
      "tr": "Hoş bulduk.",
      "tl": "Хош булдук.",
      "sub": "Рад знакомству",
      "level": "A1"
    },
    {
      "ru": "Какой у вас номер телефона?",
      "tr": "Telefon numaranız ne?",
      "tl": "Тэлэфон нумараныз нэ?",
      "sub": "Номер телефона",
      "level": "A1"
    },
    {
      "ru": "Вот мой номер.",
      "tr": "Bu benim numaram.",
      "tl": "Бу бэним нумарам.",
      "sub": "Номер телефона",
      "level": "A1"
    },
    {
      "ru": "У вас есть WhatsApp?",
      "tr": "WhatsApp'ınız var mı?",
      "tl": "Вотсапыныз вар мы?",
      "sub": "Номер телефона",
      "level": "A1"
    },
    {
      "ru": "Я напишу тебе сообщение.",
      "tr": "Sana mesaj atacağım.",
      "tl": "Сана мэсаж атаджаым.",
      "sub": "Номер телефона",
      "level": "A1"
    }
