      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
    },
    {
      "ru": "Я позвоню в …",
      "tr": "Seni saat …de ararım",
      "tl": null,
      "sub": "Знакомство — Arkadaş edinme"
