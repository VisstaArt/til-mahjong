      "level": "A2"
    },
    {
      "ru": "По-моему, тебе стоит немного подумать.",
      "tr": "Bence biraz düşünmelisin.",
      "tl": "Бэнджэ бираз дюшюнмэлисин.",
      "sub": "Советовать",
      "level": "A2"
    },
    {
      "ru": "Я не уверен(а).",
      "tr": "Emin değilim.",
      "tl": "Эмин дэйилим.",
      "sub": "Сомнение и уверенность",
      "level": "A2"
    },
    {
      "ru": "Я в этом уверен(а).",
      "tr": "Bundan eminim.",
      "tl": "Бундан эминим.",
      "sub": "Сомнение и уверенность",
      "level": "A2"
    },
    {
      "ru": "Кажется, ты прав(а).",
      "tr": "Galiba haklısın.",
      "tl": "Галиба хаклысын.",
      "sub": "Сомнение и уверенность",
      "level": "A2"
    },
    {
      "ru": "Вряд ли.",
      "tr": "Hiç sanmam.",
      "tl": "Хич санмам.",
      "sub": "Сомнение и уверенность",
      "level": "A2"
    },
    {
      "ru": "Я не уверен(а), что принял(а) правильное решение.",
      "tr": "Doğru karar verdiğimden emin değilim.",
      "tl": "Доору карар вэрдиимдэн эмин дэйилим.",
      "sub": "Сомнение и уверенность",
      "level": "B1"
    },
    {
      "ru": "Я уверен(а), что у тебя получится.",
      "tr": "Başaracağından eminim.",
      "tl": "Башараджаындан эминим.",
      "sub": "Сомнение и уверенность",
      "level": "B1"
    },
    {
      "ru": "Никто не знает, что будет.",
      "tr": "Ne olacağını kimse bilmiyor.",
      "tl": "Нэ оладжаыны кимсэ билмийор.",
      "sub": "Сомнение и уверенность",
      "level": "B1"
    },
    {
      "ru": "Я передумал(а).",
      "tr": "Fikrimi değiştirdim.",
      "tl": "Фикрими дэиштирдим.",
      "sub": "Сменить мнение",
      "level": "A2"
    },
    {
      "ru": "Оказывается, ты был(а) прав(а).",
      "tr": "Haklıymışsın.",
      "tl": "Хаклыймышсын.",
      "sub": "Сменить мнение",
      "level": "A2"
    },
    {
      "ru": "Сначала я так думал(а), а теперь не уверен(а).",
      "tr": "İlk başta öyle düşünüyordum ama şimdi emin değilim.",
      "tl": "Ильк башта ёйлэ дюшюнюйордум ама шимди эмин дэйилим.",
      "sub": "Сменить мнение",
      "level": "B1"
    },
    {
      "ru": "Ты меня убедил(а).",
      "tr": "Beni ikna ettin.",
      "tl": "Бэни икна эттин.",
      "sub": "Сменить мнение",
      "level": "A2"
    },
    {
      "ru": "Я ещё раз подумал(а) — ты прав(а).",
      "tr": "Bir daha düşündüm de, sen haklısın.",
      "tl": "Бир даха дюшюндюм дэ, сэн хаклысын.",
      "sub": "Сменить мнение",
      "level": "B1"
    },
    {
      "ru": "Оказалось, не так плохо, как я думал(а).",
      "tr": "Düşündüğüm kadar kötü değilmiş.",
      "tl": "Дюшюндююм кадар кётю дэйильмиш.",
      "sub": "Сменить мнение",
      "level": "B1"
    },
    {
      "ru": "Короче говоря, у обоих вариантов есть плюсы.",
      "tr": "Kısacası, ikisinin de iyi tarafları var.",
      "tl": "Кысаджасы, икисинин дэ ийи тарафлары вар.",
      "sub": "Подвести итог",
      "level": "B1"
    },
    {
      "ru": "В итоге решить трудно.",
      "tr": "Sonuç olarak karar vermek zor.",
      "tl": "Сонуч оларак карар вэрмэк зор.",
      "sub": "Подвести итог",
      "level": "A2"
    },
    {
      "ru": "Тогда договорились.",
      "tr": "O zaman anlaştık.",
      "tl": "О заман анлаштык.",
      "sub": "Подвести итог",
      "level": "A2"
    },
    {
      "ru": "Давай вернёмся к этому позже.",
      "tr": "Bunu sonra tekrar konuşalım.",
      "tl": "Буну сонра тэкрар конушалым.",
      "sub": "Подвести итог",
      "level": "A2"
    },
    {
      "ru": "Что бы ты ни решил(а), я с тобой.",
      "tr": "Neye karar verirsen ver, yanındayım.",
      "tl": "Нэйэ карар вэрирсэн вэр, янындайым.",
      "sub": "Подвести итог",
      "level": "B1"
    }
  ]
}
