{
  "id": "mneniya",
  "title": "Мнения",
  "source": "til",
  "phrases": [
    {
      "ru": "Как тебе? / Как ты считаешь?",
      "tr": "Sence nasıl?",
      "tl": "Сэнджэ насыл?",
      "sub": "Выразить мнение",
      "level": "A2"
    },
    {
      "ru": "Что ты об этом думаешь?",
      "tr": "Bu konuda ne düşünüyorsun?",
      "tl": "Бу конуда нэ дюшюнюйорсун?",
      "sub": "Выразить мнение",
      "level": "A2"
    },
    {
      "ru": "По-моему, это очень хорошая идея.",
      "tr": "Bence çok iyi bir fikir.",
      "tl": "Бэнджэ чок ийи бир фикир.",
      "sub": "Выразить мнение",
      "level": "A2"
    },
    {
      "ru": "Я думаю, что это правильное решение.",
      "tr": "Bunun doğru bir karar olduğunu düşünüyorum.",
      "tl": "Бунун доору бир карар олдууну дюшюнюйорум.",
      "sub": "Выразить мнение",
      "level": "B1"
    },
    {
      "ru": "Думаю, что будет трудновато.",
      "tr": "Biraz zor olacağını düşünüyorum.",
      "tl": "Бираз зор оладжаыны дюшюнюйорум.",
      "sub": "Выразить мнение",
      "level": "B1"
    },
    {
      "ru": "Мне кажется, что он (она) прав(а).",
      "tr": "Onun haklı olduğunu sanıyorum.",
      "tl": "Онун хаклы олдууну саныйорум.",
      "sub": "Выразить мнение",
      "level": "B1"
    },
    {
      "ru": "Не думаю, что эта идея сработает.",
      "tr": "Bu fikrin işe yarayacağını sanmıyorum.",
      "tl": "Бу фикрин ишэ яраяджаыны санмыйорум.",
      "sub": "Выразить мнение",
      "level": "B1"
    },
    {
      "ru": "Мне кажется, это было бы неверное решение.",
      "tr": "Yanlış bir karar olur diye düşünüyorum.",
      "tl": "Янлыш бир карар олур дийэ дюшюнюйорум.",
      "sub": "Выразить мнение",
      "level": "B1"
    },
    {
      "ru": "Если хочешь знать моё мнение, главное — семья.",
      "tr": "Bana kalırsa en önemlisi aile.",
      "tl": "Бана калырса эн ёнэмлиси аилэ.",
      "sub": "Выразить мнение",
      "level": "B1"
    },
    {
      "ru": "Честно говоря, мне не очень понравилось.",
      "tr": "Açıkçası pek beğenmedim.",
      "tl": "Ачыкчасы пэк бээнмэдим.",
      "sub": "Выразить мнение",
      "level": "A2"
    },
    {
      "ru": "Полностью согласен(на).",
      "tr": "Kesinlikle katılıyorum.",
      "tl": "Кэсинликлэ катылыйорум.",
      "sub": "Согласие и несогласие",
      "level": "A2"
    },
    {
      "ru": "Я того же мнения.",
      "tr": "Ben de aynı fikirdeyim.",
      "tl": "Бэн дэ айны фикирдэйим.",
      "sub": "Согласие и несогласие",
      "level": "A2"
    },
    {
      "ru": "В этом я с тобой не согласен(на).",
