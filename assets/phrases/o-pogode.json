{
  "id": "o-pogode",
  "title": "О погоде",
  "source": "razgovornik",
  "phrases": [
    {
      "ru": "Какая сегодня хорошая/ужасная погода!",
      "tr": "Ne güzel/berbat hava",
      "tl": null,
      "sub": null
    },
    {
      "ru": "Сегодня холодно/жарко",
