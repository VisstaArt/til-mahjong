      "tl": null,
      "sub": null
    },
    {
      "ru": "Здесь всегда так жарко?",
      "tr": "Her zaman burada bu kadar sıcak mı?",
      "tl": null,
      "sub": null
    },
    {
      "ru": "Какой прогноз на сегодня?",
      "tr": "Bugün hava raporu nasıl?",
      "tl": null,
      "sub": null
    },
    {
      "ru": "Как вы думаете сегодня будет дождь/снег?",
      "tr": "Yağmur kar yağacağını düşünüyor musunuz?",
      "tl": null,
      "sub": null
    },
    {
      "ru": "Завтра будет солнечно?",
      "tr": "Yarın güneşli olur mu?",
      "tl": null,
      "sub": null
    },
    {
      "ru": "Я думаю, завтра будет хорошая погода",
      "tr": "Sanırım yarın güzel bir gün olacak",
      "tl": null,
      "sub": null
    }
  ]
